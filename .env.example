# Copy to .env and fill in. Never commit .env.

# --- Application ---
ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

# --- Database ---
# SQLite for development; for PostgreSQL install the "postgres" extra and use:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/atlassian_agent
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
DB_AUTO_CREATE=true              # production: false, and run `alembic upgrade head`
POSTGRES_PASSWORD=               # only used by docker-compose.yml

# --- Security ---
# Service-account key ("Authorization: Bearer <key>", admin role). Required in production.
# Without it (and outside production) unauthenticated requests act as a local dev admin.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
# Fernet key that encrypts stored Atlassian API tokens. Required to save connections.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
# Signs dashboard login tokens. Required in production.
JWT_SECRET=
JWT_TTL_MINUTES=480
# First admin user, created on startup when the users table is empty.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- LLM (Google Gemini by default; OpenAI-compatible also supported) ---
LLM_PROVIDER=gemini              # gemini | openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REASONING_EFFORT=low       # gpt-5 / o-series: minimal | low | medium | high
LLM_TEMPERATURE=0.1

# --- Speech ---
STT_PROVIDER=gemini              # gemini | openai | none
TTS_PROVIDER=none                # openai | none (dashboard falls back to browser speech)
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# --- Execution policy ---
# Risk classes executed without approval. destructive/security always need approval.
AUTO_APPROVE_RISKS=["read"]
MAX_PLAN_OPERATIONS=120
LLM_REQUESTS_PER_MINUTE=8        # pace Gemini calls (free tier); 0 = unlimited

# --- Atlassian HTTP behaviour ---
ATLASSIAN_ALLOWED_HOST_SUFFIXES=[".atlassian.net"]
ATLASSIAN_TIMEOUT_SECONDS=30
ATLASSIAN_MAX_RETRIES=4

# --- Integration tests only (use a dedicated test site, never production) ---
# ATLASSIAN_TEST_SITE_URL=https://your-test-site.atlassian.net
# ATLASSIAN_TEST_EMAIL=you@example.com
# ATLASSIAN_TEST_API_TOKEN=
# ATLASSIAN_TEST_ALLOW_WRITES=1
# ATLASSIAN_TEST_PROJECT_KEY=TEST
# ATLASSIAN_TEST_SPACE_KEY=TEST
